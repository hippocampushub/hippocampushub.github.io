{
  "name": "landing-page",
  "version": "1.0.0",
  "scripts": {
    "build:css": "postcss public/style/scss/main.scss -o public/style/css/main.css",
    "watch:css": "postcss public/style/scss/main.scss -o public/style/css/main.css --watch",
    "start": "node server.js",
    "dev": "npm-run-all --parallel watch:css start"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "postcss-cli": "^10.1.0",
    "postcss-import": "^16.1.0",
    "postcss-nested": "^6.2.0",
    "postcss-scss": "^4.0.9",
    "sass": "^1.79.4",
    "tailwindcss": "^3.4.13"
  },
  "dependencies": {
    "express": "^4.18.2"
  }
}